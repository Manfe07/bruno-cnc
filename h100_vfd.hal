# Load mb2hal config
loadusr -W mb2hal config=h100_vfd.ini

# -------------------------------------------------------------------
# Typkonverter für die neuen Telemetrie-Werte laden (S32 zu Float)
# -------------------------------------------------------------------
# Stellen Sie sicher, dass "count" bei conv_s32_float oben im File groß genug ist!
# Wir benötigen hier 5 Konverter-Kanäle.

# Kanal 0: REALE DREHZAHL (Register 547 -> Index 03)
net vfd-rpm-raw        mb2hal.vfd-data.03.int => conv_s32_float.0.in
net vfd-rpm-float      conv_s32_float.0.out => spindle.0.speed-in

# Kanal 1: STROM IN AMPERE (Register 546 -> Index 02)
# Der VFD liefert z.B. 25 für 2.5A. Skalierung kann über PyVCP/Glade erfolgen.
net vfd-current-raw    mb2hal.vfd-data.02.int => conv_s32_float.1.in

# Kanal 2: VFD TEMPERATUR IN °C (Register 550 -> Index 06)
net vfd-temp-raw       mb2hal.vfd-data.06.int => conv_s32_float.2.in

# Kanal 3: LEISTUNG / LAST IN kW (Register 556 -> Index 12)
net vfd-power-raw      mb2hal.vfd-data.12.int => conv_s32_float.3.in

# Kanal 4: AUSGANGSFREQUENZ IN Hz (Register 544 -> Index 00)
net vfd-freq-raw       mb2hal.vfd-data.00.int => conv_s32_float.4.in