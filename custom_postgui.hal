# MIST COOLING
net mist-gui       pyvcp.mist-toggle        => classicladder.0.in-30
net mist-gui-out   classicladder.0.out-30   => pyvcp.mist-state

# VACUUM EXTRACTION
net vacuum-gui       pyvcp.vacuum-toggle     => classicladder.0.in-31
