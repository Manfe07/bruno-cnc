# -----------------------------
# EtherCAT and Motion Config
# -----------------------------

# Load kinematics and motion modules
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

# Load EtherCAT configuration from XML
loadusr -W lcec_conf ethercat-conf.xml

# Load EtherCAT and CIA402 drivers
loadrt lcec
loadrt cia402 count=3

# Add EtherCAT and motion processing functions to the servo thread
addf    lcec.read-all            servo-thread
addf    cia402.0.read-all        servo-thread
addf    cia402.1.read-all        servo-thread
addf    cia402.2.read-all        servo-thread
addf    motion-command-handler   servo-thread
addf    motion-controller        servo-thread
addf    cia402.0.write-all       servo-thread
addf    cia402.1.write-all       servo-thread
addf    cia402.2.write-all       servo-thread
addf    lcec.write-all           servo-thread

# Enable EMC control
setp iocontrol.0.emc-enable-in 1


# -----------------------------
# AXIS Configuration
# -----------------------------

# Set CIA402 into Profile Position Mode
setp cia402.0.csp-mode 1
setp cia402.1.csp-mode 1
setp cia402.2.csp-mode 1

# pos-scale = (encoder counts per revolution) × (mechanical ratio) ÷ (units per revolution)
# 17Bit -> 131072
# 5mm/rev -> 26214
setp cia402.0.pos-scale 26214
setp cia402.1.pos-scale -26214
setp cia402.2.pos-scale 26214


# #net x-pos-cmd     <= joint.0.motor-pos-cmd    => joint.0.motor-pos-fb
# #net y-pos-cmd     <= joint.1.motor-pos-cmd    => joint.1.motor-pos-fb
# #net z-pos-cmd     <= joint.2.motor-pos-cmd    => joint.2.motor-pos-fb


# Motion signal mappings for axis X
net x-enable      <= joint.0.amp-enable-out   => cia402.0.enable
net x-amp-fault   => joint.0.amp-fault-in     <= cia402.0.drv-fault
net x-pos-cmd     <= joint.0.motor-pos-cmd    => cia402.0.pos-cmd
net x-pos-fb      => joint.0.motor-pos-fb     <= cia402.0.pos-fb

# Motion signal mappings for axis y
net y-enable      <= joint.1.amp-enable-out   => cia402.1.enable
net y-amp-fault   => joint.1.amp-fault-in     <= cia402.1.drv-fault
net y-pos-cmd     <= joint.1.motor-pos-cmd    => cia402.1.pos-cmd
net y-pos-fb      => joint.1.motor-pos-fb     <= cia402.1.pos-fb

# Motion signal mappings for axis z
net z-enable      <= joint.2.amp-enable-out   => cia402.2.enable
net z-amp-fault   => joint.2.amp-fault-in     <= cia402.2.drv-fault
net z-pos-cmd     <= joint.2.motor-pos-cmd    => cia402.2.pos-cmd
net z-pos-fb      => joint.2.motor-pos-fb     <= cia402.2.pos-fb



# EtherCAT to CIA402 driver mapping
net x-statusword      lcec.0.xServo.status-word       => cia402.0.statusword
net x-drv-act-pos     lcec.0.xServo.pos-actual        => cia402.0.drv-actual-position

net y-statusword      lcec.0.yServo.status-word       => cia402.1.statusword
net y-drv-act-pos     lcec.0.yServo.pos-actual        => cia402.1.drv-actual-position

net z-statusword      lcec.0.zServo.status-word       => cia402.2.statusword
net z-drv-act-pos     lcec.0.zServo.pos-actual        => cia402.2.drv-actual-position

# CIA402 driver to EtherCAT mapping
net x-controlword         cia402.0.controlword            => lcec.0.xServo.control-word
net x-drv-target-pos      cia402.0.drv-target-position    => lcec.0.xServo.target-position

net y-controlword         cia402.1.controlword            => lcec.0.yServo.control-word
net y-drv-target-pos      cia402.1.drv-target-position    => lcec.0.yServo.target-position

net z-controlword         cia402.2.controlword            => lcec.0.zServo.control-word
net z-drv-target-pos      cia402.2.drv-target-position    => lcec.0.zServo.target-position



## Z-Brake
net z-enable => lcec.0.EL2809.dout-4

## Tool Probe
net probe-in => motion.probe-input <= lcec.0.EL1004.din-2-not

## Home/LimitSwitch
loadrt not count=3

addf not.0 servo-thread
addf not.1 servo-thread
addf not.2 servo-thread

net limit-x-raw <= lcec.0.EK1914.in-1 => not.0.in
net limit-y-raw <= lcec.0.EK1914.in-2 => not.1.in
net limit-z-raw <= lcec.0.EK1914.in-3 => not.2.in

#net X-home not.0.out => joint.0.home-sw-in
#net Y-home not.1.out => joint.1.home-sw-in
#net Z-home not.2.out => joint.2.home-sw-in

net X-home not.0.out => joint.0.home-sw-in joint.0.neg-lim-sw-in
net Y-home not.1.out => joint.1.home-sw-in joint.1.pos-lim-sw-in
net Z-home not.2.out => joint.2.home-sw-in joint.2.pos-lim-sw-in



# Homing
#setp lcec.0.A6.homing-method -2
#net x-home-request joint.0.request-custom-homing => cia402.0.home
#net x-homing joint.0.is-custom-homing <= cia402.0.stat-homing
#net x-homed joint.0.custom-homing-finished <= cia402.0.stat-homed
##net x-home-index <= joint.0.index-enable => cia402.0.home
