					<pdoEntry idx="0x0000" subIdx="0x00" bitLen="6" halType="complex"/> 
					<!-- Gap -->
					<pdoEntry idx="0x7000" subIdx="0x03" bitLen="16" halType="complex"/>
					<pdoEntry idx="0x7000" subIdx="0x02" bitLen="16" halType="complex"/>
				</pdo>
				
				<!-- DIO RxPDO-Map Outputs -->
				<pdo idx="0x1601">
				<!-- Die 4 Standard-Ausgänge -->
					<pdoEntry idx="0x7010" subIdx="0x01" bitLen="1" halPin="out-0" halType="bit"/>
					<pdoEntry idx="0x7010" subIdx="0x02" bitLen="1" halPin="out-1" halType="bit"/>
					<pdoEntry idx="0x7010" subIdx="0x03" bitLen="1" halPin="out-2" halType="bit"/>
					<pdoEntry idx="0x7010" subIdx="0x04" bitLen="1" halPin="out-3" halType="bit"/>
					<!-- Die 2 Safety Linked Outputs (Standard-Bits für die sicheren Ausgänge) -->
					<pdoEntry idx="0x7010" subIdx="0x05" bitLen="1" halPin="std-to-safe-out-0" halType="bit"/>
					<pdoEntry idx="0x7010" subIdx="0x06" bitLen="1" halPin="std-to-safe-out-1" halType="bit"/>
					<pdoEntry idx="0x0000" subIdx="0x00" bitLen="10" halType="complex"/>
				</pdo>
			</syncManager>
			
			<!-- Sync Manager 3: Eingänge (Slave -> Master) -->
			<syncManager idx="3" dir="in">
				<!-- FSOE TxPDO-Map -->
				<pdo idx="0x1a00">
					<pdoEntry idx="0x6000" subIdx="0x01" bitLen="8" halType="complex"/>
