		<!-- Position 1: EK1914 mit Ihrer exakten Product ID -->
		<slave idx="0" type="generic" vid="0x00000002" pid="0x077a2c52" name="EK1914">
			<!-- Sync Manager 2: Ausgänge (Master -> Slave) -->
			<syncManager idx="2" dir="out">
				<!-- FSOE RxPDO-Map (Muss mitgeladen und aufgefüllt werden) -->
				<pdo idx="0x1600">
					<pdoEntry idx="0x7000" subIdx="0x01" bitLen="8" halType="complex"/>
					<pdoEntry idx="0x7001" subIdx="0x01" bitLen="1" halType="complex"/>
