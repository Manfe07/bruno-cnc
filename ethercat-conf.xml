					<pdoEntry idx="0x6000" subIdx="0x02" bitLen="16" halType="complex"/>
					<!-- Die 2 physikalischen TwinSAFE-Eingänge als HAL-Pins freischalten -->
					<pdoEntry idx="0x6001" subIdx="0x01" bitLen="1" halPin="safe-in-0" halType="bit"/>
					<pdoEntry idx="0x6001" subIdx="0x02" bitLen="1" halPin="safe-in-1" halType="bit"/>
				</pdo>
				
				<!-- DIO TxPDO-Map Inputs -->
				<pdo idx="0x1a01">
					<!-- Die 4 Standard-Eingänge -->
					<pdoEntry idx="0x6010" subIdx="0x01" bitLen="1" halPin="in-0" halType="bit"/>
					<pdoEntry idx="0x6010" subIdx="0x02" bitLen="1" halPin="in-1" halType="bit"/>
					<pdoEntry idx="0x6010" subIdx="0x03" bitLen="1" halPin="in-2" halType="bit"/>
					<pdoEntry idx="0x6010" subIdx="0x04" bitLen="1" halPin="in-3" halType="bit"/>
					<pdoEntry idx="0x0000" subIdx="0x00" bitLen="12" halType="complex"/> <!-- Gap -->
				</pdo>
			</syncManager>
		</slave>

