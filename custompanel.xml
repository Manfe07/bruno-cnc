<?xml version='1.0' encoding='UTF-8'?>
<pyvcp>
	<labelframe text="Manual Controls">
		<vbox>		
			<hbox>
				<led>
					<halpin>"mist-state"</halpin>
					<size>20</size>
					<on_color>"green"</on_color>
					<off_color>"gray"</off_color>
				</led>
				<button>
					<text>"Mist Cooling (M7)"</text>
					<halpin>"mist-toggle"</halpin>
				</button>
			</hbox>
			<hbox>
				<led>
					<halpin>"vacuum-state"</halpin>
					<size>20</size>
					<on_color>"green"</on_color>
					<off_color>"gray"</off_color>
				</led>
				<button>
					<text>"Vacuum Cleaner"</text>
					<halpin>"vacuum-toggle"</halpin>
				</button>
			</hbox>
		</vbox>
	</labelframe>
	<vbox>
		<relief>RIDGE</relief>         
		<bd>6</bd>
		<labelframe text="Servos">
			<label>
				<text>"X Axis Torque:"</text>
			</label>
			<bar>
				<halpin>"x-torque"</halpin>
				<max_>100</max_>
			</bar>
			<label>
				<text>"Y Axis Torque:"</text>
			</label>
			<bar>
				<halpin>"y-torque"</halpin>
				<max_>100</max_>
			</bar>
			<label>
				<text>"Z Axis Torque:"</text>
			</label>
			<bar>
				<halpin>"z-torque"</halpin>
				<max_>100</max_>
			</bar>
		</labelframe>
		<labelframe text="Spindle">
			<label>
				<text>"Spindle Torque:"</text>
			</label>
			<bar>
				<halpin>"s-torque"</halpin>
				<max_>100</max_>
			</bar>
		</labelframe>
        </vbox>
</pyvcp>
